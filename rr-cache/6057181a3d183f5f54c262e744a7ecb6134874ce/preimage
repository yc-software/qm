ingress:
  enabled: false
  service: portal
  className: nginx
  hosts: []
  tls: true
  clusterIssuer: letsencrypt-prod
  tlsSecretName: ""
  annotations: {}

services:
  core:
    image: core
    port: 8080
    publicPort: 8000
    healthPath: /healthz
    readinessPath: /readyz
    startupProbe:
      httpGet:
        path: /readyz
        port: http
      periodSeconds: 5
      timeoutSeconds: 2
      failureThreshold: 60
    persistence:
      enabled: false
      existingClaim: ""
      size: 10Gi
      storageClass: null
    env: {}
    edge:
      replicas: 1
      command: ["node", "src/edge/main.ts"]
      terminationGracePeriodSeconds: 300
      resources:
        requests:
          cpu: 500m
          memory: 1Gi
        limits:
          memory: 2Gi
    harness:
      replicas: 1
      command: ["node", "src/harness/main.ts"]
      terminationGracePeriodSeconds: 300
      resources:
        requests:
          cpu: 500m
          memory: 1Gi
        limits:
          memory: 2Gi

  portal:
    enabled: true
    env: {}

  auth:
    enabled: true
    env: {}

  admin:
    enabled: true
    env: {}

  egress-proxy:
    enabled: true
    image: egress-proxy
    type: worker
    port: 48080
    replicas: 1
    command: ["/app/start.sh"]
    securityContext:
      capabilities:
        add: ["NET_ADMIN"]
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        memory: 512Mi
    env: {}
