{
  "name": "qm-web-ui-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web UI surface plugin for qm. Custom chat shell over a thin node:http transport that talks only to the core HTTP API.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "node --env-file-if-exists=.env server/index.ts",
    "start": "npm run build && npm run serve",
    "test": "NODE_ENV=test ALLOW_UNSIGNED_TEST_IDENTITY=1 node --test \"test/**/*.test.ts\"",
    "typecheck": "tsrs -p tsconfig.json --noEmit && tsrs -p tsconfig.server.json --noEmit && tsrs -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@date-fns/tz": "^1.5.0",
    "@earendil-works/pi-agent-core": "0.77.0",
    "@earendil-works/pi-ai": "0.77.0",
    "@earendil-works/pi-web-ui": "0.75.3",
    "@lezer/highlight": "1.2.4",
    "@mariozechner/mini-lit": "^0.2.0",
    "@sentry/browser": "10.75.0",
    "@sentry/node": "10.75.0",
    "@tanstack/ai-client": "0.31.1",
    "date-fns": "^4.4.0",
    "dockview-core": "^7.0.4",
    "dompurify": "^3.4.13",
    "emoji-datasource": "^16.0.0",
    "html-to-image": "1.11.13",
    "jszip": "^3.10.1",
    "lit": "^3.3.1",
    "lru-cache": "^11.5.2",
    "lucide": "^0.544.0",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^12.0.0",
    "morphdom": "2.7.8",
    "papaparse": "5.7.0",
    "posthog-js": "1.433.10"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "@types/papaparse": "5.5.2",
    "jsdom": "^29.1.1",
    "katex": "^0.16.47",
    "tsrs": "0.14.1-ts7.1.0-dev.20260929",
    "typescript": "^5.8.2",
    "vite": "^7.3.7"
  },
  "overrides": {
    "@earendil-works/pi-web-ui": {
      "@earendil-works/pi-ai": "$@earendil-works/pi-ai"
    },
    "@mariozechner/mini-lit": {
      "marked": "^18.0.5"
    },
    "@codemirror/lang-liquid": "6.3.2",
    "@lezer/highlight": "1.2.4",
    "@lezer/javascript": "1.5.5"
  }
}
