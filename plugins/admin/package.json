    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@sentry/node": "10.75.0",
    "esbuild": "^0.28.1",
    "lit": "^3.3.3"
  }
