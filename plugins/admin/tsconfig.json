{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2024",
      "esnext.array",
      "esnext.iterator",
      "esnext.promise",
      "esnext.disposable",
      "esnext.float16",
      "esnext.error",
      "dom",
      "dom.iterable"
    ],
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@sentry/node": ["./node_modules/@sentry/node/build/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "ui/**/*.ts"]
}
