diff --git a/dist/utils/idle-timeout.js b/dist/utils/idle-timeout.js
new file mode 100644
index 0000000..e36b79f
--- /dev/null
+++ b/dist/utils/idle-timeout.js
@@ -0,0 +1,49 @@
+export class StreamIdleTimeoutError extends Error {
+    constructor(idleMs) {
+        super(`Provider stream sent nothing for ${idleMs} ms`);
+        this.name = "StreamIdleTimeoutError";
+        this.idleMs = idleMs;
+    }
+}
+export function idleAbort(signal) {
+    const controller = new AbortController();
+    return { controller, signal: signal ? AbortSignal.any([signal, controller.signal]) : controller.signal };
+}
+export function idleTimeoutFetch(idleMs, controller, baseFetch) {
+    return async (url, init) => {
+        const response = await baseFetch(url, init);
+        if (!(idleMs > 0) || !response.body)
+            return response;
+        const reader = response.body.getReader();
+        let timer;
+        const body = new ReadableStream({
+            async pull(stream) {
+                const idle = new Promise((_, reject) => {
+                    timer = setTimeout(() => reject(new StreamIdleTimeoutError(idleMs)), idleMs);
+                });
+                try {
+                    const next = await Promise.race([reader.read(), idle]);
+                    if (next.done)
+                        stream.close();
+                    else
+                        stream.enqueue(next.value);
+                }
+                catch (error) {
+                    if (error instanceof StreamIdleTimeoutError) {
+                        controller.abort(error);
+                        reader.cancel(error).catch(() => { });
+                    }
+                    stream.error(error);
+                }
+                finally {
+                    clearTimeout(timer);
+                }
+            },
+            cancel(reason) {
+                clearTimeout(timer);
+                return reader.cancel(reason);
+            },
+        }, { highWaterMark: 0 });
+        return new Response(body, { status: response.status, statusText: response.statusText, headers: response.headers });
+    };
+}
