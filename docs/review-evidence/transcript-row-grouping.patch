diff --git a/plugins/web-ui/src/shell.css b/plugins/web-ui/src/shell.css
index e69ee84d..da5a5530 100644
--- a/plugins/web-ui/src/shell.css
+++ b/plugins/web-ui/src/shell.css
@@ -12487,3 +12487,56 @@ body.app-edit-embed .custom-chat-shell.app-edit-chat > .chat-bottom-dock {
   font-size: 11px;
   line-height: 1.5;
 }
+
+.delegated-work {
+  margin: 8px 0;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+.delegated-work .tool-summary {
+  flex-wrap: wrap;
+  row-gap: 4px;
+}
+.delegated-work .session-action {
+  flex: none;
+}
+.delegated-work .subagent-chip {
+  flex: 0 1 auto;
+  max-width: 100%;
+}
+.subagent-state {
+  flex: none;
+  color: var(--muted-foreground);
+  font-size: 11px;
+}
+.split-pane-parent {
+  min-width: 0;
+  max-width: 30%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  color: var(--muted-foreground);
+  text-decoration: none;
+}
+.split-pane-parent:hover {
+  color: var(--foreground);
+  text-decoration: underline;
+}
+
+.assistant-response {
+  position: relative;
+  min-width: 0;
+  padding-bottom: var(--meta-lane);
+}
+.assistant-response > .assistant-row {
+  padding-bottom: 0;
+}
+.assistant-response > .assistant-row + .assistant-row .delegated-work {
+  margin-top: 4px;
+}
+.assistant-response:hover > .message-meta,
+.assistant-response > .message-meta:focus-within {
+  opacity: 1;
+  pointer-events: auto;
+}
