--- /dev/null
+++ b/src/admin/postgres-error-log.ts
@@ -0,0 +1,82 @@
+/**
+ * Postgres-backed {@link ErrorLog} — durable operational error telemetry (spec §16
+ * `error_events`). The in-memory default ({@link createErrorLog}) is a bounded ring buffer
+ * that RESETS on every deploy and lives on a single instance, so on a blue-green / multi-instance
+ * core the admin "Errors" view is structurally blind: an event recorded into one instance's RAM
+ * is gone after a redeploy and invisible to an admin query that lands on a different instance —
+ * leaving the failed-runs row as the only durable trace. This persists every event so the Errors
+ * view reads off real history that survives restarts/redeploys/machine-replacement and is shared
+ * across instances. Mirrors {@link createPostgresMetricsSink}.
+ *
+ * Records SHAPE only — category/code, a redacted/structural message, scope label, and an optional
+ * session id for triage (spec §16: never message/file content), so it can never become a content
+ * side-channel. `record` is fire-and-forget (best-effort telemetry never blocks or fails a turn);
+ * `list` queries Postgres for the admin projection.
+ *
+ * `pg` is loaded lazily via {@link createPgPool} (dynamic import), so this stays out of the
+ * core's default zero-runtime-dep import graph until a Postgres deploy selects it (wiring.ts).
+ */
+
+import { createPgPool } from "../persistence/pg-pool.ts";
+import type { ScopeId } from "../types.ts";
+import type { ErrorEvent, ErrorLog } from "./error-log.ts";
+
+function rowToEvent(r: Record<string, unknown>): ErrorEvent {
+  return {
+    ts: Number(r.ts),
+    category: String(r.category),
+    code: String(r.code),
+    message: String(r.message),
+    scopeLabel: r.scope_label as ScopeId,
+    // Absent on events that weren't tied to a session (e.g. a process-session reconcile failure).
+    ...(r.session_id == null ? {} : { sessionId: String(r.session_id) }),
+  };
+}
+
+export function createPostgresErrorLog(connectionString: string): ErrorLog {
+  const { q } = createPgPool(
+    connectionString,
+    `
+      CREATE TABLE IF NOT EXISTS error_events(
+        id BIGSERIAL PRIMARY KEY,
+        ts BIGINT NOT NULL,
+        scope_label TEXT NOT NULL,
+        category TEXT NOT NULL,
+        code TEXT NOT NULL,
+        message TEXT NOT NULL,
+        session_id TEXT
+      );
+      CREATE INDEX IF NOT EXISTS error_events_by_ts ON error_events(ts DESC);
+      CREATE INDEX IF NOT EXISTS error_events_by_scope_ts ON error_events(scope_label, ts DESC);
+    `,
+  );
+
+  return {
+    record(e) {
+      const ts = Date.now();
+      // Fire-and-forget: telemetry must never block or fail a turn. A write error is logged, not thrown.
+      void q(
+        "INSERT INTO error_events(ts, scope_label, category, code, message, session_id) VALUES ($1,$2,$3,$4,$5,$6)",
+        [ts, e.scopeLabel, e.category, e.code, e.message, e.sessionId ?? null],
+      ).catch((err) => console.error("[errors] failed to persist error event:", err));
+    },
+    async list(opts = {}) {
+      const limit = opts.limit ?? 200;
+      const conds: string[] = [];
+      const params: unknown[] = [];
+      if (opts.scopeId !== undefined) {
+        params.push(opts.scopeId);
+        conds.push(`scope_label = $${params.length}`);
+      }
+      params.push(limit);
+      const where = conds.length ? `WHERE ${conds.join(" AND ")}` : "";
+      // `id` (BIGSERIAL) breaks ties so "most-recent-first" is deterministic even for events
+      // recorded within the same millisecond (ts has ms resolution; a burst of denials can collide).
+      const rows = await q(
+        `SELECT ts, scope_label, category, code, message, session_id FROM error_events ${where} ORDER BY ts DESC, id DESC LIMIT $${params.length}`,
+        params,
+      );
+      return rows.map(rowToEvent);
+    },
+  };
+}
