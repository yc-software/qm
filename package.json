{
  "name": "qm",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Headless core for the shared org agent (managed-agents architecture).",
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "build:connector-sdk": "npm ci --prefix deploy/connector-sdk --ignore-scripts --no-audit --no-fund && node deploy/connector-sdk/build.mjs",
    "prestart": "npm run build:connector-sdk",
    "predev": "npm run build:connector-sdk",
    "preworker": "npm run build:connector-sdk",
    "pretest": "npm run build:connector-sdk",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "SHUTDOWN_DRAIN_MS=2000 node --env-file-if-exists=.env --watch src/index.ts",
    "dev-instance": "bash scripts/dev-instance.sh up",
    "dev-instance:web": "bash scripts/dev-instance.sh up --surface web",
    "dev-instance:slack": "bash scripts/dev-instance.sh up --surface slack",
    "dev-instance:both": "bash scripts/dev-instance.sh up --surface both",
    "dev-instance:no-slack": "bash scripts/dev-instance.sh up --no-slack",
    "dev-instance:status": "bash scripts/dev-instance.sh status",
    "dev-instance:down": "bash scripts/dev-instance.sh down",
    "test": "node scripts/run-pg-tests.mjs",
    "test:root:shard": "node scripts/run-root-test-shard.mjs",
    "test:root:shard:check": "node scripts/run-root-test-shard.mjs --check --shards 5",
    "test:e2e": "node --test test/e2e/*.test.ts",
    "live-e2e": "node test/live-slack/run.ts",
    "gallery:shots": "node test/live-slack/screenshots.ts",
    "gallery:shots:login": "node test/live-slack/screenshots.ts --login",
    "test:all": "node --experimental-test-module-mocks --test 'test/**/*.test.ts'",
    "smoke:pi": "node scripts/pi-smoke.ts",
    "smoke:monitor": "node scripts/monitor-smoke.ts",
    "smoke:google-oauth": "node scripts/google-oauth-smoke.ts",
    "smoke:service-cred": "node scripts/service-credential-livetest.ts",
    "smoke:local-sandbox": "node scripts/local-sandbox-smoke.ts",
    "smoke:managed-agents-sandbox": "node --env-file-if-exists=.env scripts/managed-agents-sandbox-smoke.ts",
    "smoke:managed-agents-turn": "node --env-file-if-exists=.env scripts/managed-agents-turn-smoke.ts",
    "build:modal-image": "node scripts/modal-build-image.ts",
    "build:e2b-template": "node scripts/e2b-build-template.ts",
    "build:aws-image": "node scripts/aws-build-sandbox-image.ts",
    "sandbox:local:build": "bash scripts/local-sandbox-build.sh",
    "deploy:porter-runner-image": "docker build --platform linux/amd64 -t \"${PORTER_DEPLOY_RUNNER_IMAGE:?Set PORTER_DEPLOY_RUNNER_IMAGE to the registry tag to publish}\" -f deploy/porter-runner/Dockerfile . && docker push \"$PORTER_DEPLOY_RUNNER_IMAGE\"",
    "livetest": "node scripts/api-livetest.ts",
    "bench:memory": "node --env-file-if-exists=.env scripts/memory-bench.ts",
    "prepare": "node .husky/install.mjs",
    "typecheck": "tsrs --noEmit",
    "typecheck:contract": "tsrs -p tsconfig.contract.json",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint .",
    "lint:ox": "oxlint --deny-warnings src plugins scripts cli test",
    "dev-instance:doctor": "bash scripts/dev-instance.sh doctor",
    "lint:knip": "knip",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "build:app-annotations": "node scripts/build-app-devbar.mjs"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@aws-sdk/client-lambda-microvms": "^3.1153.0",
    "@aws-sdk/client-s3": "^3.1061.0",
    "@aws-sdk/client-sts": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1061.0",
    "@earendil-works/pi-ai": "https://github.com/yc-software/qm/releases/download/vendored-pi-ai-0.82.0-qm.1/earendil-works-pi-ai-0.82.0-qm.1.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/yc-software/qm/releases/download/vendored-pi-coding-agent-0.82.0-security.6/earendil-works-pi-coding-agent-0.82.0-qm-security.6.tgz",
    "@fly/sprites": "0.2.3",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sentry/node": "10.75.0",
    "@slack/bolt": "^4.7.3",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.19.0",
    "croner": "^10.0.1",
    "cronstrue": "3.29.0",
    "e2b": "^2.51.0",
    "emoji-datasource": "^16.0.0",
    "jose": "^6.2.3",
    "lru-cache": "^11.5.2",
    "modal": "^0.10.1",
    "nodemailer": "^10.2.1",
    "officeparser": "^8.0.0",
    "pg": "^8.13.1",
    "pg-connection-string": "2.14.0",
    "porter-sandbox": "^0.1.41",
    "tar-stream": "^3.2.0",
    "tree-sitter-bash": "^0.25.1",
    "typebox": "^1.1.38",
    "web-tree-sitter": "^0.27.0",
    "ws": "^8.21.1",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
    "hono": "4.13.13",
    "ajv": {
      "fast-uri": "3.1.9"
    },
    "brace-expansion": "^5.0.12",
    "undici": "8.12.3",
    "e2b": {
      "undici8": "npm:undici@8.12.3"
    },
    "ip-address": "10.7.4",
    "protobufjs": "7.6.5",
    "@earendil-works/pi-ai": "$@earendil-works/pi-ai"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.1",
    "@yc-software/qm": "file:./cli",
    "devbar.sh": "1.1.0",
    "esbuild": "0.28.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "husky": "9.1.7",
    "knip": "^6.26.0",
    "lint-staged": "17.0.1",
    "oxlint": "^1.74.0",
    "prettier": "3.9.1",
    "tsrs": "0.14.1-ts7.1.0-dev.20260929",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.61.0"
  }
}
